[Unit]
Description=Quantum Shield Security Monitoring Service
Documentation=https://github.com/p2w12/quantum-shield-cyber-range
After=network.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/security_monitor.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=security-monitor

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log

[Install]
WantedBy=multi-user.target
